{
  "name": "@lankacom/auth",
  "version": "0.4.0",
  "description": "Reusable, app-agnostic auth library for Next.js App Router: encrypted-JWT session cookie, server-authoritative single-flight token rotation, remember-me sliding window, backend-brokered SSO.",
  "scripts": {
    "build": "node -e \"require(\\\"fs\\\").rmSync(\\\"dist\\\",{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "keywords": [
    "auth",
    "authentication",
    "session",
    "nextjs",
    "next-app-router",
    "jwe",
    "jwt",
    "cookie",
    "token-rotation",
    "sso"
  ],
  "author": "Lankacom",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "jose": "^6.2.14",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "next": ">=15",
    "react": ">=19",
    "react-dom": ">=19"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lankacom-PVT/lankacom-auth.git"
  },
  "homepage": "https://github.com/Lankacom-PVT/lankacom-auth#readme",
  "bugs": {
    "url": "https://github.com/Lankacom-PVT/lankacom-auth/issues"
  },
  "engines": {
    "node": ">=18.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js",
      "default": "./dist/register.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js",
      "default": "./dist/client/index.js"
    },
    "./edge": {
      "types": "./dist/edge/index.d.ts",
      "import": "./dist/edge/index.js",
      "default": "./dist/edge/index.js"
    },
    "./package.json": "./package.json"
  }
}
